{
  "name": "playwright-api-testing",
  "version": "1.0.0",
  "description": "API testing with Playwright APIRequestContext — no browser needed, full REST validation",
  "scripts": {
    "test": "npx playwright test",
    "test:users": "npx playwright test tests/users/",
    "test:auth": "npx playwright test tests/auth/",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "author": "Muhammad Mustafa (https://github.com/mustafaautomation)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaautomation/playwright-api-testing.git"
  },
  "homepage": "https://github.com/mustafaautomation/playwright-api-testing#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "node": ">=22"
  }
}
